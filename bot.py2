import discord
from discord.ext import commands
import os

intents = discord.Intents.default()

bot = commands.Bot(
    command_prefix="!",
    intents=intents
)


@bot.event
async def on_ready():
    print(f"{bot.user} 로그인 완료!")


@bot.command()
@commands.has_permissions(manage_channels=True)
async def 채널생성(ctx, 개수: int):

    # 숫자가 1보다 작은 경우
    if 개수 < 1:
        await ctx.send("❌ 1 이상의 숫자를 입력해주세요.")
        return

    # 너무 많은 채널 생성 방지
    if 개수 > 9999999:
        await ctx.send("❌ 한 번에 최대 9999999개까지만 만들 수 있습니다.")
        return

    생성된채널 = []

    try:
        for i in range(1, 개수 + 1):
            채널 = await ctx.guild.create_text_channel(f"채널-{i}")
            생성된채널.append(채널)

        await ctx.send(
            f"✅ 채널 {개수}개를 생성했습니다!"
        )

    except discord.Forbidden:
        await ctx.send(
            "❌ 봇에게 채널 관리 권한이 없습니다."
        )

    except Exception as e:
        await ctx.send(
            f"❌ 채널 생성 중 오류가 발생했습니다.\n`{e}`"
        )


@채널생성.error
async def 채널생성_error(ctx, error):

    if isinstance(error, commands.MissingRequiredArgument):
        await ctx.send(
            "❌ 사용법: `!채널생성 숫자`\n예: `!채널생성 10`"
        )

    elif isinstance(error, commands.BadArgument):
        await ctx.send(
            "❌ 숫자를 입력해주세요.\n예: `!채널생성 10`"
        )

    elif isinstance(error, commands.MissingPermissions):
        await ctx.send(
            "❌ 채널을 만들 권한이 없습니다."
        )


bot.run(os.environ["DISCORD_TOKEN"])
